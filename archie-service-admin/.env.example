# ============================================================================
# archie-service-admin Environment Configuration Template
# ============================================================================
# This file serves as a template for creating your local .env file.
# Copy this file to .env and replace placeholder values with actual credentials.
# Never commit .env file to version control - it's in .gitignore for security.
# ============================================================================

# ----------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------

# Application environment (development, staging, production)
APP_ENV=development

# Application debug mode - set to false in production
DEBUG=true

# Application port
PORT=8000

# Application host
HOST=0.0.0.0

# Secret key for session management and cryptographic operations
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-replace-with-random-value

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------

# PostgreSQL database connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/archie_admin_dev

# Database connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Enable SQLAlchemy query logging (disable in production)
DB_ECHO=false

# ----------------------------------------------------------------------------
# Google Cloud Platform Configuration
# ----------------------------------------------------------------------------

# GCP Project ID for Secret Manager and other GCP services
# CRITICAL: This is the project ID (not project name) where Secret Manager stores PATs
# Used by SecretRepository for storing/retrieving Figma Personal Access Tokens
# Example: my-project-12345
GCP_PROJECT_ID=your-gcp-project-id

# Path to service account credentials JSON file (for local development)
# In production, use Application Default Credentials (ADC) instead
# Leave empty to use ADC: gcloud auth application-default login
GOOGLE_APPLICATION_CREDENTIALS=

# GCP region for regional services
GCP_REGION=us-central1

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------

# Figma Integration Feature Flag
# REQUIRED: Controls whether Figma integration endpoints are available
# Set to true to enable Figma Personal Access Token storage and frame attachments
# Set to false to disable all Figma functionality (returns feature-disabled errors)
# Default: false (disabled until explicitly enabled)
FIGMA_INTEGRATION_ENABLED=false

# ----------------------------------------------------------------------------
# Service Endpoints
# ----------------------------------------------------------------------------

# archie-service-backend URL for inter-service communication
BACKEND_SERVICE_URL=http://localhost:8080

# platform-event-listener URL for event notifications
EVENT_LISTENER_URL=http://localhost:8090

# ----------------------------------------------------------------------------
# Authentication & Authorization
# ----------------------------------------------------------------------------

# JWT secret for token verification
JWT_SECRET=your-jwt-secret-here

# JWT token expiration time (in seconds)
JWT_EXPIRATION=3600

# JWT algorithm
JWT_ALGORITHM=HS256

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log format (json, text)
LOG_FORMAT=json

# Log output destination (stdout, file)
LOG_OUTPUT=stdout

# Log file path (if LOG_OUTPUT=file)
LOG_FILE_PATH=/var/log/archie-admin/app.log

# ----------------------------------------------------------------------------
# External API Configuration
# ----------------------------------------------------------------------------

# Figma API base URL (typically no need to change)
FIGMA_API_BASE_URL=https://api.figma.com/v1

# Figma API request timeout (seconds)
FIGMA_API_TIMEOUT=30

# Figma API rate limit settings (requests per minute)
FIGMA_API_RATE_LIMIT=150

# ----------------------------------------------------------------------------
# Redis Configuration (if used for caching)
# ----------------------------------------------------------------------------

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Redis key prefix for namespace isolation
REDIS_KEY_PREFIX=archie_admin:

# Cache TTL for PAT status validation (seconds)
# Prevents excessive Figma API calls for status checks
PAT_STATUS_CACHE_TTL=300

# ----------------------------------------------------------------------------
# Security Configuration
# ----------------------------------------------------------------------------

# Secret Manager retry configuration
SECRET_MANAGER_RETRY_COUNT=3
SECRET_MANAGER_RETRY_DELAY=1

# API rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# Maximum request body size (bytes)
MAX_REQUEST_SIZE=10485760

# ----------------------------------------------------------------------------
# Monitoring & Observability
# ----------------------------------------------------------------------------

# Enable Prometheus metrics endpoint
METRICS_ENABLED=true

# Metrics endpoint port
METRICS_PORT=9090

# Enable distributed tracing
TRACING_ENABLED=false

# Jaeger agent host (if tracing enabled)
JAEGER_AGENT_HOST=localhost

# Jaeger agent port
JAEGER_AGENT_PORT=6831

# ----------------------------------------------------------------------------
# Development & Testing
# ----------------------------------------------------------------------------

# Enable development tools and endpoints
DEV_MODE=true

# Enable API documentation (Swagger/OpenAPI)
API_DOCS_ENABLED=true

# Reload application on code changes
AUTO_RELOAD=true

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
# 
# Figma Integration Setup:
# 1. Enable Secret Manager API in your GCP project
# 2. Grant service account the following IAM roles:
#    - roles/secretmanager.admin (for create/delete operations)
#    - roles/secretmanager.secretAccessor (for read operations)
# 3. Set GCP_PROJECT_ID to your GCP project ID (not project name)
# 4. Set FIGMA_INTEGRATION_ENABLED=true to enable the feature
# 5. Users will provide their Figma Personal Access Tokens via API
#
# Database Setup:
# 1. Run Alembic migrations: alembic upgrade head
# 2. Verify tables created: figma_installation, figma_installation_access, figma_attachment
#
# Local Development Authentication:
# - Use: gcloud auth application-default login
# - Or set GOOGLE_APPLICATION_CREDENTIALS to service account JSON path
#
# Production Deployment:
# - Use Application Default Credentials (service account)
# - Never set DEBUG=true
# - Set strong SECRET_KEY and JWT_SECRET values
# - Enable HTTPS and set appropriate CORS_ORIGINS
# - Set appropriate LOG_LEVEL (INFO or WARNING)
# - Configure monitoring and alerting
#
# ============================================================================
